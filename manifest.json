{
  "manifest_version": 3,
  "name": "YouTube download",
  "version": "1.2",
  "description": "YouTube Audio/Video Downloader & Metadata Extractor using yt-dlp schema",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*"
  ],
  "action": {
    "default_title": "Open YouTube Downloader"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["languages/*.json", "styles/*.css"],
      "matches": ["<all_urls>"]
    }
  ]
}